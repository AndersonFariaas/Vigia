# Copie para .env e preencha. O .env nunca vai para o Git.

# Firecrawl: coleta das páginas em markdown (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Resend: envio dos alertas por e-mail (https://resend.com)
# O remetente precisa de um domínio verificado na Resend.
RESEND_API_KEY=re_...
ALERT_EMAIL_FROM="Vigia <alertas@seudominio.com>"

# Devin: análise sob demanda dos alertas (https://devin.ai)
# Use uma chave de service user (começa com cog_) em Settings > Devin API.
DEVIN_API_KEY=cog_...
# ID da organização (começa com org-), na mesma tela.
DEVIN_ORG_ID=org-...
# Teto de consumo por análise, em ACUs (1 a 10).
DEVIN_MAX_ACU_LIMIT=2

# Agendador: expressão cron (padrão: a cada 15 minutos)
CHECK_CRON=*/15 * * * *

# Contas: true permite criar contas novas; false fecha o cadastro público.
CADASTRO_ABERTO=true

# Banco SQLite local
DATABASE_PATH=./data/vigia.db

# Servidor. Fora de 127.0.0.1, coloque HTTPS na frente: o cookie de sessão depende disso.
HOST=127.0.0.1
PORT=3000
